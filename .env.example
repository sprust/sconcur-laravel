# One .env for everything: docker compose reads it, and so does the demo application —
# its bootstrap points Laravel's environment path at the repository root rather than at
# demo/, so there is a single file to edit.

# Docker user and group IDs (root user is set by default)
# To find your user ID and group ID on Linux, use commands: `id -u` and `id -g`
DOCKER_USER_ID=0
DOCKER_GROUP_ID=0

# demo application
APP_NAME="SConcur Laravel Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=48081
APP_URL=http://localhost:48081

LOG_CHANNEL=stderr
LOG_LEVEL=debug

CACHE_STORE=file
SESSION_DRIVER=file

# The default connection of the demo. Switch to `mysql` to compare the same pages on
# the ordinary PDO connection.
DB_CONNECTION=sconcur_mysql
QUEUE_CONNECTION=sconcur_rabbitmq
BROADCAST_CONNECTION=sconcur

# sconcur — master
# The panel is what the demo's telemetry page reads. Its host is 127.0.0.1 because the
# http workers rendering that page live in the same container as the master.
SCONCUR_PANEL_PORT=28081
SCONCUR_PANEL_DOCKER_PORT=38081
SCONCUR_HTTP_ADMIN_TOKEN=_scl_admin_token_567
SCONCUR_PANEL_HOST=http://127.0.0.1:28081/api/stats
SCONCUR_HTTP_NAME=scl-master

# sconcur — http pool
# The port, not the full address: the nginx template and docker compose need the port
# on its own, and two variables that must agree is a way to make them disagree. The
# demo config builds `0.0.0.0:${SCONCUR_HTTP_PORT}` out of it.
SCONCUR_HTTP_PORT=28080
SCONCUR_HTTP_WORKER_COUNT=2

# sconcur — rabbitmq consumer pool
# Below 1 leaves the group out of the master config entirely; 0 would mean one worker
# per CPU, not none.
SCONCUR_RABBITMQ_WORKER_COUNT=1
SCONCUR_RABBITMQ_QUEUE=demo
SCONCUR_RABBITMQ_QUEUE_CONSUMERS=4
SCONCUR_RABBITMQ_PREFETCH_COUNT=1
SCONCUR_RABBITMQ_TRIES=3

# sconcur — ws pool
# Below 1 leaves the group out of the master config entirely; 0 would mean one worker
# per CPU, not none. The port, like the http one, is a variable of its own: the nginx
# template and docker compose both need it, and two variables that must agree is a way
# to make them disagree.
SCONCUR_WS_WORKER_COUNT=2
SCONCUR_WS_PORT=28090
# The key is public — the browser carries it in the connection path. The secret signs
# channel subscriptions and is known only to the http workers and the ws workers.
SCONCUR_WS_APP_KEY=_scl_ws_key_567
SCONCUR_WS_APP_SECRET=_scl_ws_secret_567
SCONCUR_WS_CLIENT_EVENTS=false

# sconcur — periodic task pool
SCONCUR_TASKS_MEMORY_MB=256

# mysql (in-memory: tmpfs, wiped when the container is recreated)
DB_HOST=scl-mysql
DB_PORT=3306
DB_DATABASE=demo
DB_USERNAME=scl_user
DB_PASSWORD=_scl_password_567
DB_ROOT_PASSWORD=_scl_root_password_567
DB_DOCKER_PORT=33306

# rabbitmq (in-memory: tmpfs, wiped when the container is recreated)
RABBITMQ_HOST=scl-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=scl_user
RABBITMQ_PASSWORD=_scl_password_567
RABBITMQ_DOCKER_PORT=35673
RABBITMQ_MANAGEMENT_DOCKER_PORT=45672
SCONCUR_RABBITMQ_DSN=amqp://scl_user:_scl_password_567@scl-rabbitmq:5672/%2f
