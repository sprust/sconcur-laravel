# The Connection header a proxied upgrade needs: "upgrade" while the client asks for
# one, and "close" otherwise, so an ordinary request is not told to switch protocols.
# It lives here, outside the server block, because `map` belongs to the http level.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;

    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    client_max_body_size 32M;

    # Docker's embedded DNS. Needed because the upstream is resolved per request
    # (see below) rather than once at startup.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        # The host goes through a variable on purpose. An `upstream` block — or a
        # literal name here — is resolved once when the config loads and cached for
        # the life of the process, so recreating the workers container hands it a
        # new IP and nginx keeps dialling the old one until it is restarted. With a
        # variable, nginx resolves per request and follows the container.
        set $sconcur workers:${SCONCUR_HTTP_PORT};

        proxy_pass http://$sconcur;

        # 1.0 is the default and cannot carry a chunked response.
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # The ws pool. A separate location, and not for tidiness: an upgraded connection is
    # long-lived, so the 60 s timeouts of the block above would cut every client loose
    # once a minute.
    location /app/ {
        set $sconcur_ws workers:${SCONCUR_WS_PORT};

        proxy_pass http://$sconcur_ws;

        proxy_http_version 1.1;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
